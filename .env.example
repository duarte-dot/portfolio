# Spotify "now playing" widget (/api/spotify)
#
# Copy to .env.local for local development with `vercel dev`, and add the same
# three variables in the Vercel dashboard for production.
# Never commit the real values: .env* is gitignored.
#
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add http://127.0.0.1:8888/callback as a Redirect URI
# 3. Run `npm run spotify:token` to mint the refresh token

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
